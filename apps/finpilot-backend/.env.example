DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finpilot
JWT_SECRET_KEY=REPLACE_ME_WITH_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# LLM providers — configure ANY combination. Whichever keys are present form
# the fallback chain; the app only fails if none are set. More providers means
# more quota headroom, which in turn keeps turns on the larger, more reliable
# models instead of degrading to small ones.
GROQ_API_KEY=REPLACE_ME
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Preferred model, promoted to the front of the chain across every provider
# that serves it. Keep this on a large model: the small ones return empty
# completions and malformed tool calls on long multi-step turns.
GROQ_MODEL=openai/gpt-oss-120b

# Per-provider model lists, so a renamed or newly available model is an .env
# edit rather than a code change.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
NVIDIA_MODELS=openai/gpt-oss-120b,nvidia/llama-3.3-nemotron-super-49b-v1.5
OPENROUTER_MODELS=openai/gpt-oss-120b
GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-2.5-pro
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000
MCP_SERVER_PORT=8100
ENVIRONMENT=development
